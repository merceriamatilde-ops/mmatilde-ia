[Unit]
Description=Matilde IA - FastAPI + Gemini
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/mmatilde-ia
EnvironmentFile=/etc/mmatilde/ia.env
ExecStart=/var/www/mmatilde-ia/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
